[
  {
    "label": "iOS: Build Lexickon",
    "command": "make",
    "args": ["build"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "SwiftLint",
    "command": "make",
    "args": ["lint"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "iOS: Test Lexickon",
    "command": "make",
    "args": ["test"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  }
]
