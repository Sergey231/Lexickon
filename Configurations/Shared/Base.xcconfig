// Settings inherited by every target and build configuration.

IPHONEOS_DEPLOYMENT_TARGET = 26.0
SWIFT_VERSION = 6.0

CLANG_ENABLE_MODULES = YES
GCC_C_LANGUAGE_STANDARD = gnu17

// Prevents Run Script phases from reading or writing undeclared paths.
ENABLE_USER_SCRIPT_SANDBOXING = YES

// Keep the string catalog as the localization source of truth. Typed symbols
// remain disabled until the project intentionally adopts generated accessors.
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
STRING_CATALOG_GENERATE_SYMBOLS = NO

// Enforces Swift 6 concurrency checking for all production and test code.
SWIFT_STRICT_CONCURRENCY = complete
